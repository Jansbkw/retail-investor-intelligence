# Copy to .env. The app works in synthetic/offline mode without API keys.
APP_ENV=development
DATABASE_PATH=data/retail_intelligence.db
CONFIG_PATH=config.yaml
DATA_MODE=synthetic

OPENAI_API_KEY=
OPENAI_MODEL_SMALL=gpt-4.1-mini
OPENAI_MODEL_LARGE=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=retail-investor-intelligence/0.1
YOUTUBE_API_KEY=

# Optional; StockTwits uses its public symbol stream by default.
STOCKTWITS_BASE_URL=https://api.stocktwits.com/api/2

