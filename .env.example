# Copy to .env. Never commit .env or any credential values.
APP_ENV=development
DATABASE_PATH=data/retail_intelligence.db
CONFIG_PATH=config.yaml
DATA_MODE=live
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8501

# Required for live LLM enrichment and generative RAG. The checked-in demo
# enrichment remains inspectable when no API key is configured.
OPENAI_API_KEY=
OPENAI_MODEL_SMALL=gpt-4.1-mini
OPENAI_MODEL_LARGE=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional live sources. Missing keys are reported as unavailable.
YOUTUBE_API_KEY=
X_BEARER_TOKEN=

# X Recent Search may incur API cost. Set true only after explicit approval.
ALLOW_PAID_X_CALLS=false

# Stocktwits is retrieved only through the separately authorised Codex MCP.
# No Stocktwits OAuth credential or undocumented HTTP endpoint belongs here.

